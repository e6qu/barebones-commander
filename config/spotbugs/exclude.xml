<?xml version="1.0" encoding="UTF-8"?>
<!--
  SpotBugs filter. Vendored upstream packages (Sun NFS / Sun GSS /
  sun.net.www) are not ours to fix; suppress wholesale. The build
  fails on any NEW finding in our own code, which is why we want
  this filter to stay tight.
-->
<FindBugsFilter>

  <!-- ThemeCache.foregroundColors / .backgroundColors are public
       static arrays read on every cell render by FileTable, the
       folders-tree renderer, the shortcuts table, etc. The arrays
       are populated in the static initialiser and mutated only by
       the ThemeListener event handlers (delegated to static setters
       in Phase 20). The exposure is an intentional architectural
       tradeoff for hot-path lookup — wrapping with a getter that
       returns Collections.unmodifiableList would defeat the purpose,
       and a defensive copy per render is unacceptable. -->
  <Match><Class name="~dev\.barebones\.commander\.ui\.theme\.ThemeCache"/><Bug pattern="MS_MUTABLE_ARRAY"/></Match>

  <!-- Vendored upstream packages — not ours to fix. -->
  <Match><Package name="~com\.sun\.file.*"/></Match>
  <Match><Package name="~com\.sun\.gssapi.*"/></Match>
  <Match><Package name="~com\.sun\.nfs.*"/></Match>
  <Match><Package name="~com\.sun\.rpc.*"/></Match>
  <Match><Package name="~com\.sun\.xfile.*"/></Match>
  <Match><Package name="~com\.sun\.xfilechooser.*"/></Match>
  <Match><Package name="~com\.sun\.xhandler.*"/></Match>
  <Match><Package name="~sun\.net\.www.*"/></Match>

</FindBugsFilter>
